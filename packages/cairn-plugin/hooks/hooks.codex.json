{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.mjs\" hook session-start --host codex --model-provider codex",
            "statusMessage": "Loading Cairn context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.mjs\" hook stop --host codex --model-provider codex",
            "statusMessage": "Checking Cairn continuity"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.mjs\" hook user-prompt-submit --host codex --model-provider codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.mjs\" hook read-enrich --host codex --model-provider codex"
          }
        ]
      },
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.mjs\" hook post-write --host codex --model-provider codex"
          }
        ]
      }
    ]
  }
}
