{
  "name": "@isaacriehm/cairn-plugin",
  "version": "0.33.0",
  "description": "Cairn agent plugin for Claude Code, Cursor, and Codex: shared skills, hooks, MCP config, and the bundled CLI.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "mcp",
    "decision-records",
    "adr",
    "context-engineering",
    "claude-code-plugin"
  ],
  "author": "Isaac Riehm",
  "license": "MIT",
  "homepage": "https://github.com/isaacriehm/cairn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacriehm/cairn.git",
    "directory": "packages/cairn-plugin"
  },
  "bugs": {
    "url": "https://github.com/isaacriehm/cairn/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "files": [
    ".claude-plugin",
    ".cursor-plugin",
    ".codex-plugin",
    ".mcp.json",
    ".mcp.codex.json",
    "mcp.json",
    "hooks",
    "rules",
    "skills",
    "agents",
    "commands",
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/check-layout.mjs && node scripts/build-bundle.mjs",
    "typecheck": "node scripts/check-layout.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@isaacriehm/cairn": "workspace:*",
    "@isaacriehm/cairn-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1"
  }
}
