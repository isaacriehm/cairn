{
  "name": "@isaacriehm/cairn-plugin",
  "version": "0.32.1",
  "description": "Agent plugin frontend for Cairn — Claude Code + Cursor (shared skills, agents, dist).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "files": [
    ".claude-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "mcp.json",
    "hooks",
    "rules",
    "skills",
    "agents",
    "commands",
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/check-layout.mjs && node scripts/build-bundle.mjs",
    "typecheck": "node scripts/check-layout.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@isaacriehm/cairn": "workspace:*",
    "@isaacriehm/cairn-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "esbuild": "^0.28.0"
  }
}
